GATEWAY_APP_NAME=Privacy Gateway
GATEWAY_ENVIRONMENT=development
GATEWAY_LOG_LEVEL=INFO

# Host-run development defaults. Docker Compose builds an internal service URL
# from the POSTGRES_* variables below instead.
GATEWAY_DATABASE_URL=postgresql+asyncpg://privacy_gateway:change-this-local-password@localhost:5432/privacy_gateway
GATEWAY_REDIS_URL=redis://localhost:6379/0

POSTGRES_USER=privacy_gateway
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=privacy_gateway