APP_NAME=Privacy Gateway
ENVIRONMENT=development
LOG_LEVEL=INFO

# Host-run development defaults. Docker Compose builds an internal service URL
# from the POSTGRES_* variables below instead.
DATABASE_URL=postgresql+asyncpg://privacy_gateway:change-this-local-password@localhost:5432/privacy_gateway
REDIS_URL=redis://localhost:6379/0

POSTGRES_USER=privacy_gateway
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=privacy_gateway