GATEWAY_APP_NAME=Privacy Gateway
GATEWAY_ENVIRONMENT=development
GATEWAY_LOG_LEVEL=INFO

# Host-run development defaults. Docker Compose builds an internal service URL
# from the POSTGRES_* variables below instead.
GATEWAY_DATABASE_URL=postgresql+asyncpg://privacy_gateway:change-this-local-password@localhost:5432/privacy_gateway
GATEWAY_REDIS_URL=redis://localhost:6379/0

POSTGRES_USER=privacy_gateway
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=privacy_gateway

# PROTOTYPE vault keys (development only; production must use a KMS/HSM provider,
# and the local key provider refuses to start when GATEWAY_ENVIRONMENT=production).
# Never commit real values. Generate each 32-byte key with:
#   python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# GATEWAY_VAULT_MASTER_KEYS=dev-1:<base64-32-byte-key>
# GATEWAY_VAULT_ACTIVE_KEY_ID=dev-1
# GATEWAY_VAULT_TOKEN_HASH_KEY=<different-base64-32-byte-key>
# GATEWAY_VAULT_TOKEN_TTL_SECONDS=86400
